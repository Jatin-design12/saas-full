# Evegah EV Mobility Platform — Environment Configuration Template
# Copy this file to .env and provide real secrets for production deployment.

PORT=5000
NODE_ENV=development

# Database Settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evegah_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=evegah_db

# Security & Cryptographic Settings
JWT_SECRET=your-256-bit-cryptographically-secure-jwt-secret-key-change-in-production
JWT_ISSUER=evegah.com
JWT_AUDIENCE=evegah-api
JWT_EXPIRES_IN=24h
INTERNAL_API_KEY=evegah-internal-microservice-key

# PayU Payment Gateway Credentials
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
PAYU_ENV=production

# ICICI Bank UPI & Encryption Credentials
ICICI_MID=
ICICI_TERMINAL_ID=
ICICI_VPA=
ICICI_API_KEY=
ICICI_PAYEE_NAME=Evegah
ICICI_BASE_URL=https://apibankingone.icici.bank.in/api/MerchantAPI/UPI/v0
ICICI_PUBLIC_KEY=
ICICI_PRIVATE_KEY=
ICICI_ENCRYPTION_MODE=asymmetric

# WhatsApp & Notifications Service
WHATSAPP_API_KEY=
FCM_SERVER_KEY=

# Sandbox.co.in Aadhaar eKYC Credentials
SANDBOX_API_KEY=key_live_...
SANDBOX_API_SECRET=secret_live_...
# Optional: defaults automatically to https://api.sandbox.co.in for key_live_* or https://test-api.sandbox.co.in for key_test_*
SANDBOX_BASE_URL=
SANDBOX_ENV=production
